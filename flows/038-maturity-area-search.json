{
  "id": "maturity-area-search",
  "title": "Search Maturity Areas",
  "description": "Search the MA navigator by code, name or Orchard and recover from a no-results query.",
  "category": "Navigation and selection",
  "order": 38,
  "profiles": [
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Search Maturity Areas",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "At least one Maturity Area is available."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Search Maturity Areas",
      "instruction": "Use the search box to narrow Maturity Areas by code, name or parent Orchard.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-navigator']"
          }
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "minCount": 1,
          "message": "No Maturity Areas are available."
        }
      ],
      "capture": {
        "file": "01-search.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='maturity-area-search']"
            },
            "label": "Search MA code, name or Orchard",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='maturity-area-groups']"
            },
            "label": "Scoped MAs",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "See and clear no results",
      "instruction": "A search with no match shows an explicit empty state; clear it to restore the grouped list.",
      "actions": [
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='maturity-area-search']"
          },
          "value": "__NO_MATURITY_AREA_MATCH__"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-empty']"
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-no-results.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='maturity-area-empty']"
            },
            "label": "No matching MAs",
            "number": 1,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Restore all Maturity Areas",
      "instruction": "Clear the search to return to the current scoped MA list.",
      "actions": [
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='maturity-area-search']"
          },
          "value": ""
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-groups']"
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "03-restored.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='maturity-area-groups']"
            },
            "label": "MAs restored",
            "number": 1,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    }
  ]
}
