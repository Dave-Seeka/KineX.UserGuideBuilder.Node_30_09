{
  "id": "business-form-focus",
  "title": "Focus on the Business Form",
  "description": "Expand a Business Form, use the selected-entity context rail, and return to the full GIS workspace.",
  "category": "View details",
  "order": 78,
  "profiles": [
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Focus on the Business Form",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "At least one Orchard is available."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open Orchard details",
      "instruction": "Select an Orchard and use the expand control in its Business Form header.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "minCount": 1,
          "message": "No Orchard is available.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='orchard']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='business-form-full-screen']"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-full-screen='True'], [data-guide='business-form-shell'][data-guide-full-screen='true']"
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "01-focused.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='business-form-context-rail']"
            },
            "label": "Selected entity context",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='business-focus-full-gis']"
            },
            "label": "Return to full GIS",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='business-form-shell']"
            },
            "label": "Focused Business Form",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Return to full GIS",
      "instruction": "Use Full GIS to restore the standard map, navigator and Business Form layout.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='business-focus-full-gis']"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-context-rail']"
          },
          "state": "hidden",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-full-gis.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='orchard-workbench']"
            },
            "label": "Full GIS workspace",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      }
    }
  ]
}
