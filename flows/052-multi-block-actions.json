{
  "id": "multi-block-actions",
  "title": "Manage a multi-Block selection",
  "description": "Use Overview, Allocation and Activity for a multi-Block selection, then clear it.",
  "category": "Navigation and selection",
  "order": 52,
  "profiles": [
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Manage a multi-Block selection",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "One Orchard has at least two Blocks."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Build a multi-Block selection",
      "instruction": "Select two Blocks to open the combined Business Form.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "clickCandidateUntil",
          "locator": {
            "selector": "[data-guide='open-blocks']"
          },
          "successLocator": {
            "selector": "[data-guide='block-select']"
          },
          "resetLocator": {
            "selector": "[data-guide='back-to-orchards']"
          },
          "returnLocator": {
            "selector": "[data-guide='orchard-navigator']"
          },
          "minCount": 2,
          "perCandidateTimeoutMs": 4000,
          "timeoutMs": 45000,
          "message": "No Orchard with at least 2 Blocks is available."
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='block-toggle']"
          },
          "nth": 0
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='block-toggle']"
          },
          "nth": 1
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='blocks']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "01-selected.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='business-form-shell'][data-guide-entity='blocks']"
            },
            "label": "Combined Business Form",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='multi-block-clear']"
            },
            "label": "Clear selection",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Review Allocation",
      "instruction": "Allocation shows the current effective Maturity Area assignment for every selected Block.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "tab",
            "name": "Allocation",
            "exact": true
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='multi-block-allocation-list']"
          }
        }
      ],
      "capture": {
        "file": "02-allocation.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='multi-block-allocation-list']"
            },
            "label": "Allocation list",
            "number": 1,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='multi-block-allocation-row']"
            },
            "label": "Block allocation",
            "number": 2,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6,
            "optional": true
          }
        ]
      }
    },
    {
      "heading": "Review Activity",
      "instruction": "Activity brings the selected Blocks’ effective history into one timeline.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "tab",
            "name": "Activity",
            "exact": true
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-activity-content']"
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "03-activity.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "role": "tab",
              "name": "Activity",
              "exact": true
            },
            "label": "Activity",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='multi-block-timeline']"
            },
            "label": "Combined timeline",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6,
            "optional": true
          }
        ]
      }
    },
    {
      "heading": "Clear the selection",
      "instruction": "Clear all returns to normal single-record Browse selection.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='multi-block-clear']"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='blocks']"
          },
          "state": "hidden",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "04-cleared.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='block-navigator']"
            },
            "label": "Block navigator",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      }
    }
  ]
}
