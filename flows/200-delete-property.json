{
  "id": "delete-property",
  "title": "Delete a Property",
  "description": "Return to a parent Property, open delete confirmation and cancel.",
  "category": "Delete records",
  "order": 200,
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "Permission to view and delete Properties."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open confirmation",
      "instruction": "Open the Property navigator, select a Property, then choose Delete.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "button[role='tab'][title='Properties']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='property-navigator']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-property-row button[aria-label^='Select Property ']"
          },
          "minCount": 1,
          "message": "No Property is available.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": ".workbench-property-row button[aria-label^='Select Property ']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='property']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='delete-property']"
          },
          "message": "Property delete is unavailable.",
          "minCount": 1,
          "timeoutMs": 10000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='delete-property']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='delete-dialog']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "01-confirm.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='delete-dialog']"
            },
            "label": "Confirm Property",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='delete-cancel'] button"
            },
            "label": "Cancel",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='delete-confirm'] button"
            },
            "label": "Delete",
            "number": 3,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      }
    }
