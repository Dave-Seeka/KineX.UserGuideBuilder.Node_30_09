  "order": 10,
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "A valid AppSelection Season is selected."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open Orchard Workbench",
      "instruction": "Confirm the AppSelection context before using the navigator or map.",
