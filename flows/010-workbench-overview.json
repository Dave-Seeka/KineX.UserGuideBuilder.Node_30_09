        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='app-selection']"
            },
            "label": "Season, crop and country",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6,
            "boxTimeoutMs": 10000
          },
          {
            "locator": {
              "selector": "[data-guide='workbench-sidebar']"
            },
            "label": "Property, Orchard and Block navigator",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='workbench-map-panel']"
            },
            "label": "ArcGIS map",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='workbench-crud-header']"
            },
            "label": "Context actions",
            "number": 4,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='workbench-business-form']"
            },
            "label": "Business details",
            "number": 5,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6,
