{
  "id": "create-block-validation",
  "title": "Understand Block creation requirements",
  "description": "Review the auto-generated Block code and the required name, Production status and Cover status stages.",
  "category": "Create records",
  "order": 122,
  "profiles": [
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Understand Block creation requirements",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "An Orchard is available and the user can create Blocks."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Review required Block fields",
      "instruction": "Open Create Block and review the first required stage before entering a Block name.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "minCount": 1,
          "message": "No Orchard is available.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "[data-guide='context-create-action'][data-guide-create-entity='block'][data-guide-parent-id]"
          },
          "successLocator": {
            "selector": "[data-guide='entity-create-drawer'][data-guide-entity='block']"
          },
          "timeoutMs": 30000,
          "message": "Create Block did not open."
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='entity-create-drawer'][data-guide-entity='block']"
          }
        },
        {
          "type": "assertDisabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          }
        }
      ],
      "capture": {
        "file": "01-required.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='block-code']"
            },
            "label": "Auto-generated when saved",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='block-name']"
            },
            "label": "Required Block name",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-continue-action'] button"
            },
            "label": "Continue disabled",
            "number": 3,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-cancel-action'] button"
      },
      "timeoutMs": 1500
    }
  ]
}
