{
  "id": "create-block",
  "title": "Create a Block",
  "description": "Complete the current four-stage Block wizard through Review without submitting.",
  "category": "Create records",
  "order": 120,
  "profiles": [
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Create a Block",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "Permission to create Blocks.",
    "At least one Orchard is available."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Start Create Block",
      "instruction": "Select an Orchard and open Create Block. The Block code is generated when the record is saved.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForTimeout",
          "ms": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "minCount": 1,
          "message": "No Orchard is available.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": "[data-guide='orchard-select']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='context-create-action'][data-guide-create-entity='block'][data-guide-parent-id]"
          },
          "minCount": 1,
          "message": "Create Block is unavailable until the selected Orchard context is stable.",
          "timeoutMs": 10000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "[data-guide='context-create-action'][data-guide-create-entity='block'][data-guide-parent-id]"
          },
          "successLocator": {
            "selector": "[data-guide='entity-create-drawer'][data-guide-entity='block']"
          },
          "timeoutMs": 30000,
          "perAttemptTimeoutMs": 1500,
          "message": "Create Block did not open after the Orchard selection settled."
        },
        {
          "type": "skipIfVisible",
          "locator": {
            "text": "Create-form options are temporarily rate limited"
          },
          "message": "Create-form options are temporarily rate limited. Close the form and try again shortly.",
          "timeoutMs": 2000
        }
      ],
      "capture": {
        "file": "01-block.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='block-parent-context']"
            },
            "label": "Parent Orchard",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='block-code']"
            },
            "label": "Auto-generated code",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='block-name']"
            },
            "label": "Block name",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Enter Block identity",
      "instruction": "Enter the Block name. The code is intentionally read-only and is assigned at save time.",
      "actions": [
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='block-name'] input"
          },
          "value": "{{guideData.blockName}} {{runId}}",
          "timeoutMs": 20000
        },
        {
          "type": "waitForEnabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          }
        }
      ],
      "capture": {
        "file": "02-production.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "label": "Production status *"
            },
            "label": "Production status",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='block-monitoring']"
            },
            "label": "Monitoring",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-continue-action'] button"
            },
            "label": "Continue",
            "number": 3,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Complete Production",
      "instruction": "Choose the required Production status and continue to Structure and establishment.",
      "actions": [
        {
          "type": "selectFirstOption",
          "locator": {
            "label": "Production status *"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitForEnabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          }
        }
      ],
      "capture": {
        "file": "03-structure.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "label": "Cover status *"
            },
            "label": "Cover status",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-continue-action'] button"
            },
            "label": "Continue",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Complete Structure and review",
      "instruction": "Choose the required Cover status and continue to Review. Do not create the Block.",
      "actions": [
        {
          "type": "selectFirstOption",
          "locator": {
            "label": "Cover status *"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitForEnabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='block-review-step']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "04-review.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='block-review-step']"
            },
            "label": "Block review",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-submit-action'] button"
            },
            "label": "Create after confirmation",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertVisible",
          "label": "Block review",
          "locator": {
            "selector": "[data-guide='block-review-step']"
          }
        }
      ]
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-cancel-action'] button"
      },
      "timeoutMs": 1500
    }
  ]
}
