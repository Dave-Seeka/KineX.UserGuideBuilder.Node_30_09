{
  "id": "split-pick",
  "title": "Use Split Pick",
  "description": "Open Split Pick for an unmapped assigned Block and review percentage allocation without applying the strategy.",
  "category": "Pick strategies",
  "order": 174,
  "profiles": [
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Use Split Pick",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "A Maturity Area has an assigned Block without linked geometry and Split Pick permission."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Find Split Pick",
      "instruction": "In MA Allocation, Split Pick is the direct secondary action for an unmapped assigned Block.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "successLocator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000,
          "perAttemptTimeoutMs": 1200
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "minCount": 1,
          "message": "No Maturity Area is available for the selected scope.",
          "timeoutMs": 15000
        },
        {
          "type": "clickCandidateUntil",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "afterClickActions": [
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
              },
              "timeoutMs": 5000
            },
            {
              "type": "click",
              "locator": {
                "role": "tab",
                "name": "Allocation",
                "exact": true
              },
              "timeoutMs": 5000
            },
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='ma-blocks-tab']"
              },
              "timeoutMs": 5000
            }
          ],
          "successLocator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "timeoutMs": 60000,
          "perCandidateTimeoutMs": 6000,
          "message": "No Maturity Area currently exposes Split Pick for the required Block state."
        },
        {
          "type": "require",
          "locator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "minCount": 1,
          "message": "Split Pick is not available on the selected Maturity Area.",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "01-split-pick-action.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "tr:has(.workbench-multi-block-table__map--missing) .workbench-multi-block-table__map--missing"
            },
            "label": "No Map Block",
            "number": 1,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
            },
            "label": "Split Pick",
            "number": 2,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Review Split Pick allocation",
      "instruction": "Split Pick allocates percentages of the whole non-spatial Block across destination MAs. The allocation must total 100%.",
      "actions": [
        {
          "type": "clickFirst",
          "locator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='split']"
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-split-pick-drawer.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='pick-strategy-selector']"
            },
            "label": "Split / Select strategy",
            "number": 1,
            "color": "#7c3aed",
            "labelBackground": "#7c3aed",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='split-pick-total']"
            },
            "label": "Total allocation",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-line']"
            },
            "label": "Destination MA and % of Block",
            "number": 3,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-current-membership']"
            },
            "label": "Current physical membership",
            "number": 4,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6,
            "optional": true
          }
        ]
      }
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "label": "Close pick strategy",
        "exact": true
      },
      "timeoutMs": 1500
    }
  ]
}
