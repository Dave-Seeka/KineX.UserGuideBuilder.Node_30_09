{
  "id": "edit-property-no-changes",
  "title": "Cancel a Property edit",
  "description": "Open the effective-dated Property edit, confirm Save is disabled until values change, then cancel.",
  "category": "Edit records",
  "order": 152,
  "profiles": [
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Cancel a Property edit",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "An editable Property is available."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Review the unchanged Property",
      "instruction": "Select a Property, choose Edit, and confirm the effective date for the change.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "click",
          "locator": {
            "role": "tab",
            "name": "Properties"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='property-navigator']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-property-row button[aria-label^='Select Property ']"
          },
          "minCount": 1,
          "message": "No Property is available.",
          "timeoutMs": 15000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": ".workbench-property-row button[aria-label^='Select Property ']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='property']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='business-edit-action']:not(:disabled)"
          },
          "minCount": 1,
          "message": "Edit is unavailable for this record.",
          "timeoutMs": 10000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='business-edit-action']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='schedule-change-modal']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "clickIfVisible",
          "locator": {
            "role": "button",
            "name": "Use viewed state",
            "exact": true
          },
          "timeoutMs": 1500
        },
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "Continue",
            "exact": true
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-mode='edit']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "01-edit.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='business-form-content']"
            },
            "label": "Editable Property fields",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='business-edit-cancel'] button"
            },
            "label": "Cancel",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='business-edit-save'] button"
            },
            "label": "Save disabled",
            "number": 3,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertDisabled",
          "label": "Save is disabled until something changes",
          "locator": {
            "selector": "[data-guide='business-edit-save'] button"
          }
        }
      ]
    },
    {
      "heading": "Cancel the edit",
      "instruction": "Return to Property view mode without saving.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='business-edit-cancel'] button"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-mode='edit']"
          },
          "state": "hidden",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-cancelled.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='business-form-shell'][data-guide-mode='view']"
            },
            "label": "Property view mode",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertNoToast",
          "contains": "Saved",
          "durationMs": 1000
        }
      ]
    }
  ]
}
