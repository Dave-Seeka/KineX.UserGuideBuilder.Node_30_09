{
  "id": "create-orchard-new-property-manual-address",
  "title": "Create Orchard with a new Property and manual address",
  "description": "Create the parent Property inside the Orchard wizard and use manual address entry.",
  "category": "Create records",
  "order": 100,
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "Permission to create Orchards and Properties."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Choose Create new Property",
      "instruction": "Change the Property source to Create new.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForTimeout",
          "ms": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='create-orchard']:not(:disabled)"
          },
          "message": "Create Orchard is temporarily unavailable for the current session.",
          "minCount": 1,
          "timeoutMs": 10000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-orchard']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='entity-create-drawer']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "skipIfVisible",
          "locator": {
            "text": "Create-form options are temporarily rate limited"
          },
          "message": "Create-form options are temporarily rate limited. Close the form and try again shortly.",
          "timeoutMs": 2000
        },
        {
          "type": "selectOption",
          "locator": {
            "selector": "[data-guide='property-source']"
          },
          "value": "new",
          "timeoutMs": 20000,
          "label": "Create new"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='property-address']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "01-new-property.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='property-source']"
            },
            "label": "Create new",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='property-country']"
            },
            "label": "Country",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='property-effective-date']"
            },
            "label": "Effective date",
            "number": 3,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Choose manual address",
      "instruction": "Enter identity values, then choose Create New Address.",
      "actions": [
        {
          "type": "selectFirstOptionIfEmpty",
          "locator": {
            "selector": "[data-guide='property-country']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='address-manual-options-button']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='address-manual-options']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='address-create-new']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='address-manual-fields']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "02-manual.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='address-manual-heading']"
            },
            "label": "Unverified manual address",
            "number": 1,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='address-line-1']"
            },
            "label": "Street",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='address-city']"
            },
            "label": "City",
            "number": 3,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='address-region']"
            },
            "label": "Region",
            "number": 4,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='address-postal-code']"
            },
            "label": "Postcode",
            "number": 5,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Complete the address",
      "instruction": "Enter the required physical address fields.",
      "actions": [
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-line-1'] input"
          },
          "value": "{{guideData.manualAddressLine1}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-line-2'] input"
          },
          "value": "{{guideData.manualAddressLine2}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-suburb'] input"
          },
          "value": "{{guideData.manualSuburb}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-city'] input"
          },
          "value": "{{guideData.manualCity}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-region'] input"
          },
          "value": "{{guideData.manualRegion}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='address-postal-code'] input"
          },
          "value": "{{guideData.manualPostalCode}}",
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "03-address.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='address-manual-fields']"
            },
            "label": "Physical address",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-continue-action'] button"
            },
            "label": "Continue",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Enter Orchard details",
      "instruction": "Continue and complete the required Orchard fields.",
      "actions": [
        {
          "type": "waitForEnabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-details-step']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "selectFirstOptionIfEmpty",
          "locator": {
            "selector": "[data-guide='orchard-crop']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "fillValidOrchardPin",
          "locator": {
            "selector": "[data-guide='orchard-pin'] input"
          },
          "cropLocator": {
            "selector": "[data-guide='orchard-crop']"
          },
          "prefix": "{{guideData.orchardPin}}",
          "timeoutMs": 20000
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='orchard-name'] input"
          },
          "value": "{{guideData.orchardName}} {{runId}}",
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "04-orchard.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='orchard-pin']"
            },
            "label": "PIN",
            "number": 1,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='orchard-name']"
            },
            "label": "Name",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='orchard-crop']"
            },
            "label": "Crop",
            "number": 3,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='orchard-season-context']"
            },
            "label": "Season",
            "number": 4,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Review both records",
      "instruction": "Continue through optional details to the combined Review. Do not submit.",
      "actions": [
        {
          "type": "waitForEnabled",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitForTimeout",
          "ms": 700
        },
        {
          "type": "clickIfVisible",
          "locator": {
            "selector": "[data-guide='create-continue-action'] button"
          },
          "timeoutMs": 2500
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-review-step']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "05-review.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='orchard-review-step']"
            },
            "label": "Property and Orchard review",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-submit-action'] button"
            },
            "label": "Create both records",
            "number": 2,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertVisible",
          "label": "Combined review",
          "locator": {
            "selector": "[data-guide='orchard-review-step']"
          }
        }
      ]
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-cancel-action'] button"
      },
      "timeoutMs": 1500,
      "force": true
    },
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-back-action'] button"
      },
      "timeoutMs": 1500
    },
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-back-action'] button"
      },
      "timeoutMs": 1500
    }
  ],
  "profiles": [
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Create Orchard with a new Property and manual address",
    "mode": "safe",
    "dataGated": true
  }
}
