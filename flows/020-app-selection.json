{
  "id": "app-selection",
  "title": "Set AppSelection",
  "description": "Review the Season, Crop and Country scope used by the Workbench.",
  "category": "Getting started",
  "order": 20,
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open AppSelection",
      "instruction": "Select the badges in the application header.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForTimeout",
          "ms": 1200
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='app-selection']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='app-selection-modal']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "01-modal.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='app-selection-season']"
            },
            "label": "Season",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='app-selection-crop']"
            },
            "label": "Crop",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='app-selection-country']"
            },
            "label": "Country",
            "number": 3,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='app-selection-apply']"
            },
            "label": "Apply scope",
            "number": 4,
            "color": "#d92d20",
            "labelBackground": "#d92d20",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertVisible",
          "label": "AppSelection opened",
          "locator": {
            "selector": "[data-guide='app-selection-modal']"
          }
        },
        {
          "type": "assertVisible",
          "label": "Season selector",
          "locator": {
            "selector": "[data-guide='app-selection-season']"
          }
        },
        {
          "type": "assertVisible",
          "label": "Crop selector",
          "locator": {
            "selector": "[data-guide='app-selection-crop']"
          }
        },
        {
          "type": "assertVisible",
          "label": "Country selector",
          "locator": {
            "selector": "[data-guide='app-selection-country']"
          }
        }
      ]
    },
    {
      "heading": "Close without changing",
      "instruction": "Use Cancel when you only needed to inspect the current selection.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='app-selection-cancel']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "02-summary.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='app-selection']"
            },
            "label": "Current scope",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6,
            "boxTimeoutMs": 10000
          }
        ]
      },
      "checks": [
        {
          "type": "assertHidden",
          "label": "AppSelection closed",
          "locator": {
            "selector": "[data-guide='app-selection-modal']"
          },
          "timeoutMs": 10000
        },
        {
          "type": "assertVisible",
          "label": "Current scope remains visible",
          "locator": {
            "selector": "[data-guide='app-selection']"
          }
        }
      ]
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='app-selection-cancel']"
      },
      "timeoutMs": 1500
    }
  ],
  "profiles": [
    "smoke",
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Set AppSelection",
    "mode": "safe",
    "dataGated": false
  }
}
