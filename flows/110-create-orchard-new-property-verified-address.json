{
  "id": "create-orchard-new-property-verified-address",
  "title": "Use an ArcGIS-verified Property address",
  "description": "Use address search for a new parent Property. The guide skips if lookup is unavailable.",
  "category": "Create records",
  "order": 110,
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "Permission to create Orchards and Properties.",
    "ArcGIS address lookup is available."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open address lookup",
      "instruction": "Prepare a new Property and locate the ArcGIS search input.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForTimeout",
          "ms": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='create-orchard']:not(:disabled)"
          },
          "message": "Create Orchard is temporarily unavailable for the current session.",
          "minCount": 1,
          "timeoutMs": 10000
        },
        {
          "type": "click",
          "locator": {
            "selector": "[data-guide='create-orchard']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='entity-create-drawer']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "skipIfVisible",
          "locator": {
            "text": "Create-form options are temporarily rate limited"
          },
          "message": "Create-form options are temporarily rate limited. Close the form and try again shortly.",
          "timeoutMs": 2000
        },
        {
          "type": "selectOption",
          "locator": {
            "selector": "[data-guide='property-source']"
          },
          "value": "new",
          "timeoutMs": 20000,
          "label": "Create new"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='property-address']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "selectFirstOptionIfEmpty",
          "locator": {
            "selector": "[data-guide='property-country']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "require",
          "locator": {
            "role": "searchbox",
            "name": "Search",
            "exact": true
          },
          "message": "ArcGIS address search is unavailable.",
          "minCount": 1,
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "01-search.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='address-search']"
            },
            "label": "Search address",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='address-manual-options-button']"
            },
            "label": "Manual fallback",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Select a verified result",
      "instruction": "Enter the configured address and choose the first suggestion.",
      "actions": [
        {
          "type": "fill",
          "locator": {
            "role": "searchbox",
            "name": "Search",
            "exact": true
          },
          "value": "{{guideData.addressSearch}}",
          "timeoutMs": 20000
        },
        {
          "type": "press",
          "locator": {
            "role": "searchbox",
            "name": "Search",
            "exact": true
          },
          "key": "ArrowDown",
          "timeoutMs": 20000
        },
        {
          "type": "press",
          "locator": {
            "role": "searchbox",
            "name": "Search",
            "exact": true
          },
          "key": "Enter",
          "timeoutMs": 20000
        },
        {
          "type": "waitForTimeout",
          "ms": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='address-verified-result']"
          },
          "message": "No complete verified result was returned.",
          "minCount": 1,
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-verified.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='address-verified-result']"
            },
            "label": "Verified result",
            "number": 1,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='create-continue-action'] button"
            },
            "label": "Continue",
            "number": 2,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      }
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-cancel-action'] button"
      },
      "timeoutMs": 1500,
      "force": true
    },
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-back-action'] button"
      },
      "timeoutMs": 1500
    },
    {
      "type": "clickIfVisible",
      "locator": {
        "selector": "[data-guide='create-back-action'] button"
      },
      "timeoutMs": 1500
    }
  ],
  "profiles": [
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Use an ArcGIS-verified Property address",
    "mode": "safe",
    "dataGated": true
  }
}
