{
  "id": "mutation-select-pick",
  "title": "Apply Select Pick",
  "description": "Add a second Select Pick sizing allocation, balance estimated yield to 100%, apply the strategy and capture the saved state.",
  "category": "Mutation verification",
  "order": 328,
  "profiles": [
    "mutation"
  ],
  "mutation": true,
  "coverage": {
    "capability": "Apply Select Pick",
    "mode": "mutation",
    "dataGated": true
  },
  "safety": "This flow persists a Select Pick strategy. Run only in a disposable test environment with the mutation confirmation enabled.",
  "prerequisites": [
    "A Maturity Area has at least one assigned Block and Select Pick permission.",
    "The Orchard has at least two Maturity Areas available at the selected effective date."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open Select Pick",
      "instruction": "Find a Maturity Area whose current Allocation HTML exposes Apply Select Pick.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "successLocator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000,
          "perAttemptTimeoutMs": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "minCount": 1,
          "message": "No Maturity Area is available for the selected scope.",
          "timeoutMs": 15000
        },
        {
          "type": "clickCandidateUntil",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "afterClickActions": [
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
              },
              "timeoutMs": 5000
            },
            {
              "type": "click",
              "locator": {
                "role": "tab",
                "name": "Allocation",
                "exact": true
              },
              "timeoutMs": 5000
            },
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='ma-blocks-tab']"
              },
              "timeoutMs": 5000
            }
          ],
          "successLocator": {
            "selector": "[data-guide='multi-block-table-additional-action'][aria-label^='Select Pick ']:not(:disabled)"
          },
          "timeoutMs": 60000,
          "perCandidateTimeoutMs": 6000,
          "message": "No Maturity Area currently exposes Apply Select Pick for the required Block state."
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='multi-block-table-additional-action'][aria-label^='Select Pick ']:not(:disabled)"
          },
          "minCount": 1,
          "message": "Apply Select Pick is not available on the selected Maturity Area.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": "[data-guide='multi-block-table-additional-action'][aria-label^='Select Pick ']:not(:disabled)"
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='select']"
          },
          "timeoutMs": 10000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] select option:not([value=''])"
          },
          "minCount": 2,
          "message": "Apply Select Pick capture requires at least two Maturity Areas at the selected effective date.",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "01-select-pick-open.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='pick-strategy-selector']"
            },
            "label": "Apply Select Pick",
            "number": 1,
            "color": "#7c3aed",
            "labelBackground": "#7c3aed",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='select']"
            },
            "label": "Allocation drawer",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertVisible",
          "label": "Apply Select Pick drawer open",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='select']"
          }
        }
      ]
    },
    {
      "heading": "Add a sizing allocation",
      "instruction": "Add another allocation, route it to another Maturity Area and assign two sizing groups at 50% estimated yield each.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "+ Add allocation",
            "exact": true
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-allocation-line']",
            "nth": 1
          },
          "timeoutMs": 10000
        },
        {
          "type": "evaluate",
          "script": "(() => { const lines = [...document.querySelectorAll(\"[data-guide='ma-allocation-line']\")]; if (lines.length < 2) throw new Error('Expected two Select Pick allocation lines.'); const first = lines[0].querySelector('select'); const second = lines[1].querySelector('select'); if (!first || !second) throw new Error('Select Pick Maturity Area selectors were not found.'); const option = [...second.options].find((candidate) => !candidate.disabled && candidate.value && candidate.value !== first.value); if (!option) throw new Error('A second Maturity Area is required for Select Pick capture.'); second.value = option.value; second.dispatchEvent(new Event('change', { bubbles: true })); })()"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='text']",
            "nth": 0
          },
          "value": "B"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='text']",
            "nth": 0
          },
          "key": "Tab"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='text']",
            "nth": 1
          },
          "value": "3C"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='text']",
            "nth": 1
          },
          "key": "Tab"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 0
          },
          "value": "50"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 0
          },
          "key": "Tab"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 1
          },
          "value": "50"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 1
          },
          "key": "Tab"
        },
        {
          "type": "waitForEnabled",
          "locator": {
            "role": "button",
            "name": "Apply Select Pick",
            "exact": true
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-select-pick-allocation.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-line']",
              "nth": 0
            },
            "label": "First sizing allocation",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-line']",
              "nth": 1
            },
            "label": "Added sizing allocation",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='select-pick-total']"
            },
            "label": "100% estimated yield",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "role": "button",
              "name": "Apply Select Pick",
              "exact": true
            },
            "label": "Save Select Pick",
            "number": 4,
            "color": "#7c3aed",
            "labelBackground": "#7c3aed",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertEnabled",
          "label": "Apply Select Pick enabled",
          "locator": {
            "role": "button",
            "name": "Apply Select Pick",
            "exact": true
          }
        }
      ]
    },
    {
      "heading": "Save Select Pick",
      "instruction": "Apply the strategy and verify the saved MA Allocation HTML state, success message and Apply Select Pick indicator.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "Apply Select Pick",
            "exact": true
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "text": "Select Pick strategy applied.",
            "exact": true
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='select']"
          },
          "timeoutMs": 30000
        }
      ],
      "capture": {
        "file": "03-select-pick-saved.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "text": "Select Pick strategy applied.",
              "exact": true
            },
            "label": "Saved strategy",
            "number": 1,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='select']"
            },
            "label": "Apply Select Pick indicator",
            "number": 2,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertHidden",
          "label": "Allocation drawer closed",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer']"
          },
          "timeoutMs": 10000
        },
        {
          "type": "assertAttribute",
          "label": "Allocation tab remains active",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
          },
          "name": "data-guide-tab",
          "exact": "allocation"
        },
        {
          "type": "assertText",
          "label": "Saved strategy message",
          "locator": {
            "text": "Select Pick strategy applied.",
            "exact": true
          },
          "exactText": "Select Pick strategy applied."
        },
        {
          "type": "assertCount",
          "label": "Apply Select Pick indicator rendered",
          "locator": {
            "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='select']"
          },
          "min": 1,
          "visibleOnly": true
        }
      ]
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "label": "Close pick strategy",
        "exact": true
      },
      "timeoutMs": 1500
    }
  ]
}
