{
  "id": "mutation-split-pick",
  "title": "Apply Split Pick",
  "description": "Add a second Split Pick allocation, balance the Block to 100%, apply the strategy and capture the saved state.",
  "category": "Mutation verification",
  "order": 326,
  "profiles": [
    "mutation"
  ],
  "mutation": true,
  "coverage": {
    "capability": "Apply Split Pick",
    "mode": "mutation",
    "dataGated": true
  },
  "safety": "This flow persists a Split Pick strategy. Run only in a disposable test environment with the mutation confirmation enabled.",
  "prerequisites": [
    "A Maturity Area has an assigned Block without linked geometry and Split Pick permission.",
    "The Orchard has at least two Maturity Areas available at the selected effective date."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open Split Pick",
      "instruction": "Find a Maturity Area whose current Allocation HTML exposes Apply Split Pick.",
      "actions": [
        {
          "type": "goto",
          "path": "/arcgis/orchard-workbench"
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitForMapReady",
          "timeoutMs": 120000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "successLocator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000,
          "perAttemptTimeoutMs": 1200
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "minCount": 1,
          "message": "No Maturity Area is available for the selected scope.",
          "timeoutMs": 15000
        },
        {
          "type": "clickCandidateUntil",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "afterClickActions": [
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
              },
              "timeoutMs": 5000
            },
            {
              "type": "click",
              "locator": {
                "role": "tab",
                "name": "Allocation",
                "exact": true
              },
              "timeoutMs": 5000
            },
            {
              "type": "waitFor",
              "locator": {
                "selector": "[data-guide='ma-blocks-tab']"
              },
              "timeoutMs": 5000
            }
          ],
          "successLocator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "timeoutMs": 60000,
          "perCandidateTimeoutMs": 6000,
          "message": "No Maturity Area currently exposes Apply Split Pick for the required Block state."
        },
        {
          "type": "require",
          "locator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "minCount": 1,
          "message": "Apply Split Pick is not available on the selected Maturity Area.",
          "timeoutMs": 10000
        },
        {
          "type": "clickFirst",
          "locator": {
            "selector": "tr:has(.workbench-multi-block-table__map--missing) [data-guide='multi-block-table-secondary-action'][aria-label^='Split Pick ']:not(:disabled)"
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='split']"
          },
          "timeoutMs": 10000
        },
        {
          "type": "require",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] select option:not([value=''])"
          },
          "minCount": 2,
          "message": "Apply Split Pick capture requires at least two Maturity Areas at the selected effective date.",
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "01-split-pick-open.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='pick-strategy-selector']"
            },
            "label": "Apply Split Pick",
            "number": 1,
            "color": "#7c3aed",
            "labelBackground": "#7c3aed",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='split']"
            },
            "label": "Allocation drawer",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertVisible",
          "label": "Apply Split Pick drawer open",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer'][data-guide-strategy='split']"
          }
        }
      ]
    },
    {
      "heading": "Add a destination allocation",
      "instruction": "Add another allocation, choose a different Maturity Area and split the whole Block 50/50 so the strategy totals 100%.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "+ Add allocation",
            "exact": true
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-allocation-line']",
            "nth": 1
          },
          "timeoutMs": 10000
        },
        {
          "type": "evaluate",
          "script": "(() => { const lines = [...document.querySelectorAll(\"[data-guide='ma-allocation-line']\")]; if (lines.length < 2) throw new Error('Expected two Split Pick allocation lines.'); const first = lines[0].querySelector('select'); const second = lines[1].querySelector('select'); if (!first || !second) throw new Error('Split Pick Maturity Area selectors were not found.'); const option = [...second.options].find((candidate) => !candidate.disabled && candidate.value && candidate.value !== first.value); if (!option) throw new Error('A second Maturity Area is required for Split Pick capture.'); second.value = option.value; second.dispatchEvent(new Event('change', { bubbles: true })); })()"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 0
          },
          "value": "50"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 0
          },
          "key": "Tab"
        },
        {
          "type": "fill",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 1
          },
          "value": "50"
        },
        {
          "type": "press",
          "locator": {
            "selector": "[data-guide='ma-allocation-line'] input[type='number']",
            "nth": 1
          },
          "key": "Tab"
        },
        {
          "type": "waitForEnabled",
          "locator": {
            "role": "button",
            "name": "Apply Split Pick",
            "exact": true
          },
          "timeoutMs": 10000
        }
      ],
      "capture": {
        "file": "02-split-pick-allocation.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-line']",
              "nth": 0
            },
            "label": "Source allocation",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-allocation-line']",
              "nth": 1
            },
            "label": "Added allocation",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='split-pick-total']"
            },
            "label": "100% total",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "role": "button",
              "name": "Apply Split Pick",
              "exact": true
            },
            "label": "Save Split Pick",
            "number": 4,
            "color": "#7c3aed",
            "labelBackground": "#7c3aed",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertEnabled",
          "label": "Apply Split Pick enabled",
          "locator": {
            "role": "button",
            "name": "Apply Split Pick",
            "exact": true
          }
        }
      ]
    },
    {
      "heading": "Save Split Pick",
      "instruction": "Apply the strategy and verify the saved MA Allocation HTML state, success message and Apply Split Pick indicator.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "Apply Split Pick",
            "exact": true
          },
          "timeoutMs": 10000
        },
        {
          "type": "waitFor",
          "locator": {
            "text": "Split Pick strategy applied.",
            "exact": true
          },
          "timeoutMs": 30000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='split']"
          },
          "timeoutMs": 30000
        }
      ],
      "capture": {
        "file": "03-split-pick-saved.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "text": "Split Pick strategy applied.",
              "exact": true
            },
            "label": "Saved strategy",
            "number": 1,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='split']"
            },
            "label": "Apply Split Pick indicator",
            "number": 2,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          }
        ]
      },
      "checks": [
        {
          "type": "assertHidden",
          "label": "Allocation drawer closed",
          "locator": {
            "selector": "[data-guide='ma-allocation-drawer']"
          },
          "timeoutMs": 10000
        },
        {
          "type": "assertAttribute",
          "label": "Allocation tab remains active",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
          },
          "name": "data-guide-tab",
          "exact": "allocation"
        },
        {
          "type": "assertText",
          "label": "Saved strategy message",
          "locator": {
            "text": "Split Pick strategy applied.",
            "exact": true
          },
          "exactText": "Split Pick strategy applied."
        },
        {
          "type": "assertCount",
          "label": "Apply Split Pick indicator rendered",
          "locator": {
            "selector": "[data-guide='ma-block-pick-strategy-indicator'][data-strategy='split']"
          },
          "min": 1,
          "visibleOnly": true
        }
      ]
    }
  ],
  "cleanupActions": [
    {
      "type": "clickIfVisible",
      "locator": {
        "label": "Close pick strategy",
        "exact": true
      },
      "timeoutMs": 1500
    }
  ]
}
