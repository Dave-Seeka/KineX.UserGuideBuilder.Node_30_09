{
  "id": "maturity-area-navigator",
  "title": "Find and select Maturity Areas",
  "description": "Use the first-class Maturity Area navigator, grouped by parent Orchard, to open MA details.",
  "category": "Navigation and selection",
  "order": 36,
  "profiles": [
    "core",
    "full"
  ],
  "mutation": false,
  "coverage": {
    "capability": "Find and select Maturity Areas",
    "mode": "safe",
    "dataGated": true
  },
  "safety": "This guide does not save, publish or delete records.",
  "prerequisites": [
    "At least one Maturity Area is available in the selected scope."
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "heading": "Open the Maturity Area navigator",
      "instruction": "Select Maturity Areas to browse scoped MAs grouped under their parent Orchard.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "clickUntilVisible",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "successLocator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000,
          "perAttemptTimeoutMs": 1200
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-navigator']"
          }
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          },
          "minCount": 1,
          "message": "No Maturity Areas are available."
        }
      ],
      "capture": {
        "file": "01-navigator.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "button[role='tab'][title='Maturity Areas']"
            },
            "label": "MAs tab",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='maturity-area-search']"
            },
            "label": "Search MAs",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='maturity-area-groups']"
            },
            "label": "Grouped by Orchard",
            "number": 3,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Select a Maturity Area",
      "instruction": "Select an MA to open its Overview Business Form.",
      "actions": [
        {
          "type": "clickFirst",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
          },
          "timeoutMs": 20000
        }
      ],
      "capture": {
        "file": "02-selected.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": ".workbench-ma-row--selected button"
            },
            "label": "Selected MA",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
            },
            "label": "Maturity Area details",
            "number": 2,
            "color": "#15803d",
            "labelBackground": "#15803d",
            "padding": 6
          }
        ]
      }
    }
  ]
}
