      "heading": "Open MA Allocation",
      "instruction": "Select an MA and open Allocation to review its effective Block membership.",
      "actions": [
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='orchard-workbench']"
          },
          "timeoutMs": 30000
        },
        {
          "type": "click",
          "locator": {
            "selector": "button[role='tab'][title='Maturity Areas']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='maturity-area-navigator']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "require",
          "locator": {
            "selector": ".workbench-ma-row button[aria-label^='Select Maturity Area ']"
