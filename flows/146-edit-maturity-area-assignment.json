        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='business-form-shell'][data-guide-entity='maturity area']"
          },
          "timeoutMs": 20000
        },
        {
          "type": "click",
          "locator": {
            "role": "tab",
            "name": "Allocation",
            "exact": true
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='ma-blocks-tab']"
          }
        },
        {
          "type": "require",
          "locator": {
            "role": "button",
            "name": "Edit assignment",
            "exact": true
          },
          "minCount": 1,
          "message": "MA assignment editing is unavailable."
        }
      ],
      "capture": {
        "file": "01-allocation.png",
        "fullPage": false,
        "highlights": [
          {
            "locator": {
              "selector": "[data-guide='ma-blocks-tab']"
            },
            "label": "Block membership",
            "number": 1,
            "color": "#0058a4",
            "labelBackground": "#0058a4",
            "padding": 6
          },
          {
            "locator": {
              "role": "button",
              "name": "Edit assignment",
              "exact": true
            },
            "label": "Edit assignment",
            "number": 2,
            "color": "#b45309",
            "labelBackground": "#b45309",
            "padding": 6
          }
        ]
      }
    },
    {
      "heading": "Schedule assignment change",
      "instruction": "Choose Edit assignment, confirm the effective date, and review assignment checkboxes without saving.",
      "actions": [
        {
          "type": "click",
          "locator": {
            "role": "button",
            "name": "Edit assignment",
            "exact": true
          }
        },
        {
          "type": "waitFor",
          "locator": {
            "selector": "[data-guide='schedule-change-modal']"
          }
        },
        {
          "type": "clickIfVisible",
          "locator": {
            "role": "button",
            "name": "Use viewed state",
            "exact": true
          },
          "timeoutMs": 1500
